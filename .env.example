# Copy to `.env` (gitignored) and fill in. Restart Expo after changes.
# Never commit real tokens.

# Mapbox public token (pk.*) — enables Directions walking for SPEC-002 geometry.
# Without it, the app uses MockSafeRouter.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Strava OAuth (SPEC-010)
# Create an app at https://www.strava.com/settings/api
# Authorization Callback Domain / Redirect:
#   run4travel://strava/callback
#   (also add the URI shown by the app / Expo AuthSession for web)
#
# Client SECRET in EXPO_PUBLIC_* is DEMO-ONLY. In production, exchange tokens on a server.
EXPO_PUBLIC_STRAVA_CLIENT_ID=
EXPO_PUBLIC_STRAVA_CLIENT_SECRET=
# Optional override; default is AuthSession makeRedirectUri(scheme run4travel)
# EXPO_PUBLIC_STRAVA_REDIRECT_URI=run4travel://strava/callback
